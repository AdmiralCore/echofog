# Copy to deploy/v2/.env and edit:  cp deploy/v2/.env.example deploy/v2/.env
# Every value below is a placeholder; nothing here is a real address or key.

# The image to run. v2-dev is built by GitHub from the v2 branch. Pin a build with its commit tag
# when you want updates only on purpose, e.g. ghcr.io/admiralcore/echofog-node:sha-1234567.
ECHOFOG_IMAGE=ghcr.io/admiralcore/echofog-node:v2-dev

# REQUIRED on the first start: the public IPv4 or IPv6 address of this server, as an IP literal
# (for example 203.0.113.10 from the documentation range). It goes into the node's card. A name is
# refused. Leave empty here and set it in your own .env.
ECHOFOG_ADVERTISE_ADDR=

# The public port. With a cover, reality2-quic and reality2-tcp listen on it (UDP and TCP), so the
# node looks like an ordinary HTTPS site; noise3 moves to ECHOFOG_PORT+1.
ECHOFOG_PORT=443

# The noise3 port when a cover takes 443. Leave it at 444 and publish it in docker-compose.yml:
# with ECHOFOG_COVER the node serves reality2-quic and reality2-tcp on ECHOFOG_PORT and noise3 here.
ECHOFOG_NOISE_PORT=444

# The cover: the operator's own site on the operator's own domain (T2.6e, own-cover mode).
# ECHOFOG_COVER is a host:port such as node.example.org:443; its name must resolve to
# ECHOFOG_ADVERTISE_ADDR. ECHOFOG_SITE_DIR is the folder with the real site (index.html and the
# rest). Without both, the node has no public card: it works for its own people over noise3 only.
ECHOFOG_COVER=
ECHOFOG_SITE_DIR=

# Optional: the TLS certificate of the cover domain as a PEM bundle (certificate chain and its
# private key in one file). Empty means ACME (Let's Encrypt), which needs TCP 80 or TCP 443.
ECHOFOG_COVER_CERT=

# What this node does: relay, mailbox, dht-server, exit (comma-separated). An empty value switches
# every role off. exit shares this server's connection: turn it on only where you may do that.
ECHOFOG_ROLES=relay,mailbox,dht-server

# Invitations (links that let someone in with a term of access): true opens one more listener on
# ECHOFOG_PORT+1 (or +2 with a cover, because noise3 already takes the spare port). Publish it in
# docker-compose.yml when you switch this on.
ECHOFOG_INVITES=false

# Where the profile lives inside the container. Leave it.
# ECHOFOG_DATA_DIR=/data

# After the first start:
#   docker compose -f deploy/v2/docker-compose.yml exec node echofog-node v2 status --data /data
#   docker compose -f deploy/v2/docker-compose.yml exec node echofog-node v2 invite create --data /data --access 30d
# The recovery phrase is in /data/recovery-phrase.txt: copy it and delete the file.
