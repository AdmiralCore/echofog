# Copy to deploy/.env and adjust. Every option of "echofog-node run" has an ECHOFOG_* variable.

# Nodes to join through, comma-separated host:port/peerid (a domain name is fine). Empty: the
# built-in node of the build (docs/run-a-node.md, "Join the network"); a list here replaces it.
ECHOFOG_BOOTSTRAP=

# What this node runs (docs/run-a-node.md):
#   server  a relay or exit: DHT, peer exchange, relay with mailboxes for others, signaling, exit,
#           wallet. No chat, calls or file transfer: nobody can write to or call this node
#           itself, it hands out no encryption keys, and frames of those kinds are dropped on
#           arrival. Mail between other people still passes through it.
#   client  everything the desktop app runs, chat and calls included (the default outside Docker)
ECHOFOG_ROLE=server

# The image to run. Empty: ghcr.io/admiralcore/echofog-node:latest, built by GitHub from main. Pin a
# build with its commit tag, e.g. ghcr.io/admiralcore/echofog-node:sha-4d6bfaa.
# ECHOFOG_IMAGE=

# Relay for peers that cannot reach each other directly, and a mailbox for offline peers.
ECHOFOG_RELAY=true
ECHOFOG_RELAY_MAX_CIRCUITS=200

# Signaling only: the DHT and hole punching help for peers behind NATs, but no relayed traffic and
# no kept messages. Cheap in bandwidth; the network still needs relays elsewhere.
ECHOFOG_SIGNALING=false

# Share this server's connection as an exit: public, or only for the people with its invitation
# link when ECHOFOG_ACCESS (below) is hidden or isolated. Price in dollars per GB, paid in TON or
# USDT into the node's own wallet (0 = free). Only on a server where you may do this.
ECHOFOG_EXIT=false
ECHOFOG_EXIT_PRICE=0.05
# A priced exit needs ~0.1-0.2 TON on the node's own wallet: clients mostly pay from their deposit,
# and collecting that is a transaction whose fee (about 0.015 TON) the node's wallet pays. With an
# empty wallet the money waits ("vouchers: ... owed ... (the node wallet has no TON ...)" in the
# stats). The address is in "echofog-node status"; testnet TON: Telegram bot @testgiver_ton_bot.
# Upload speed to advertise, in Mbit/s. Put roughly what the server really has (100 is a safe
# guess for a small cloud VM). 0 means "measure it against peers", which needs other peers to be
# connected already: on a fresh server it often finds none, and the exit then never starts
# ("Exit sharing not started: no peers to measure upload speed against").
ECHOFOG_EXIT_UPLOAD_MBPS=100
# Peers this exit serves for free, without the daily quota or payment (your own phone and laptop:
# the peer ID is in the app under Proxy -> Relay -> Your peer ID), comma-separated. It replaces the free list kept in the
# data volume; leave it empty to keep the list as it is.
# ECHOFOG_EXIT_FREE_PEERS=<peer id>,<peer id>

# Who may reach this node (docs/hidden-nodes.md):
#   public    listed in the network; with ECHOFOG_EXIT=true its exit is advertised to everybody
#   hidden    uses the network as a client but is not listed; relays for nobody (ECHOFOG_RELAY is
#             ignored) and serves only the people with its invitation link and those who joined
#   isolated  joins no network at all (ECHOFOG_BOOTSTRAP is ignored): people with the link connect
#             to it directly, so the published port must be reachable
# Hidden and isolated nodes advertise no speed: ECHOFOG_EXIT_UPLOAD_MBPS does not matter for them.
# Get the link:  docker compose -f deploy/docker-compose.yml exec node echofog-node invite
# Changing the mode takes a restart: docker compose -f deploy/docker-compose.yml up -d
ECHOFOG_ACCESS=public
# The access secret inside the link. Empty: generated on the first start and kept in the data
# volume (it survives restarts and rebuilds). Set the same one on several nodes so that one link
# lets people in everywhere; make one with:
#   docker compose -f deploy/docker-compose.yml run --rm node invite --new-secret
# Or keep it in a Docker secret (see docker-compose.yml) with ECHOFOG_ACCESS_SECRET_FILE.
# ECHOFOG_ACCESS_SECRET=
# ECHOFOG_ACCESS_SECRET_FILE=/run/secrets/echofog_access_secret
# Addresses put into the link, comma-separated host:port (a domain name is fine). Inside Docker the
# node learns its public IP from STUN and puts it in the link with ECHOFOG_ADVERTISE_PORT; set this
# when people should use a domain, or when the server has several IPs.
# ECHOFOG_PUBLIC_ADDR=vpn.example.org:443

# TON network of the node's wallet: testnet (the default while the vault contract is unaudited, so
# nobody pays real money during testing) or mainnet.
# ECHOFOG_TON_NETWORK=testnet

# Public port peers use to reach this node. The compose publishes host 443 to the container's
# 4242, so announce 443 (join address and TCP fallback). Leave empty if you do not map ports.
ECHOFOG_ADVERTISE_PORT=443

# Anti-DPI disguise: the node imitates a real website in its own hosting block, and finds one by
# itself (near its address at start-up, then a slower wider search in the background). Until it has
# one it runs on UDP only and logs an ANTI-DPI warning. To see the sites at once or pick one
# yourself: docker compose run --rm node camouflage, then put the two lines it prints here.
# See docs/anti-dpi.md.
# ECHOFOG_TLS_SERVER_NAME=
# ECHOFOG_CAMOUFLAGE_ADDR=

# Operator API: passes (personal links with a term, devices and traffic) for your own payment or
# moderation, used by your Telegram bot or website. Off unless both are set. Publish the port only
# on loopback (see docker-compose.yml) or keep the bot in the same compose network. docs/operator-api.md
# ECHOFOG_API_ADDR=0.0.0.0:8090
# ECHOFOG_API_TOKEN=   # at least 16 characters: openssl rand -hex 24

# The pass bot in Telegram (docker-compose.bot.yml, tg-bot/README.md). Needs the API above.
# TG_BOT_TOKEN=        # from @BotFather
# TG_ADMIN_IDS=        # your numeric Telegram ID (@userinfobot), comma-separated
# TG_STARS_PRICE=0     # 0: only hand passes out; a number: sell TG_DAYS days for that many Stars
# TG_DAYS=30
# TG_DEVICES=2
# TG_LANG=             # ru or en for everybody; empty: by each person's Telegram language

# A stats line in the log: peers, relayed traffic, messages kept for offline peers, earnings.
ECHOFOG_STATS_EVERY=1m
ECHOFOG_LOG_LEVEL=info

# Restore an existing identity on the first start instead of creating a new one: put the 12 or
# 24 words in a file mounted into the container, or run "echofog-node restore" once.
# ECHOFOG_MNEMONIC_FILE=/data/recovery-phrase.txt

# Without a password one is generated and kept in /data/.node_password.
# ECHOFOG_PASSWORD_FILE=/run/secrets/echofog_password

# Limits on what peers can take from the relay and the exit (docs/run-a-node.md, "Relay and exit
# limits"). Leave them out for the defaults; for the numbers 0 keeps the default, -1 removes the limit.
# Connections (0 keeps the default, -1 removes the limit; see docs/node-security.md):
# ECHOFOG_MAX_PEERS=0                   # peers that connected to this node (default 2048 on a server)
# ECHOFOG_MAX_PEERS_PER_IP=16
# ECHOFOG_MAX_PEERS_PER_SUBNET=64       # per /24 (IPv6 /56)
# ECHOFOG_MAX_IDS_PER_IP=32             # different peer IDs from one address in 10 minutes
# ECHOFOG_MAX_IDS_PER_SUBNET=128
# ECHOFOG_WS_CLIENT_IP_HEADER=CF-Connecting-IP   # only if WebSocket is reachable through the CDN alone
# ECHOFOG_BWPROBE_MB_PER_MIN=48         # speed probes answered for others, MB a minute in all
# ECHOFOG_NO_BWPROBE_SERVE=false        # true: answer none
#
# ECHOFOG_RELAY_MBPS=0                  # everything relayed, Mbit/s (0 = no limit): set it below the uplink
# ECHOFOG_RELAY_PEER_MBPS=50            # one peer's relayed connections, Mbit/s
# ECHOFOG_RELAY_PEER_MB_PER_DAY=16384   # what one peer's relayed connections carry a day
# ECHOFOG_RELAY_CIRCUIT_MB=4096         # what one relayed connection carries
# ECHOFOG_RELAY_CIRCUITS_PER_PEER=16
# ECHOFOG_RELAY_CIRCUITS_PER_IP=32      # one /24 gets twice this
# ECHOFOG_RELAY_RESERVED_PCT=25         # of ECHOFOG_RELAY_MAX_CIRCUITS, kept for peers connected 10+ min
# ECHOFOG_RELAY_IDLE=5m                 # a relayed connection moving less than ECHOFOG_RELAY_IDLE_KB...
# ECHOFOG_RELAY_IDLE_KB=32              # ...in ECHOFOG_RELAY_IDLE is closed
# ECHOFOG_EXIT_MAX_STREAMS=4096         # exit connections and UDP sessions at once
# ECHOFOG_EXIT_STREAMS_PER_PEER=256
# ECHOFOG_EXIT_STREAMS_PER_IP=512
# ECHOFOG_EXIT_UDP_PER_PEER=32
# ECHOFOG_EXIT_IDLE=5m                  # close an exit TCP connection idle this long (0 = never)
# ECHOFOG_EXIT_MAX_LIFETIME=0           # close it after this long anyway (0 = never)
# ECHOFOG_EXIT_FREE_PEER_MBPS=50        # free exit: one client's speed, Mbit/s
# ECHOFOG_EXIT_FREE_IP_MBPS=100         # free exit: all the clients of one IP address
# Traffic caps of a free exit, off by default (0 = no cap). For a server whose traffic you pay by the GB:
# ECHOFOG_EXIT_FREE_MB_PER_DAY=0        # free exit: MB one client may take a day (UTC)
# ECHOFOG_EXIT_FREE_IP_MB_PER_DAY=0     # free exit: MB all the clients of one IP address may take a day
# ECHOFOG_EXIT_FREE_GB_PER_MONTH=0      # free exit: GB the whole exit gives away a month, then it stops until the next
